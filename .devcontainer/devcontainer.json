{
  "name": "SST/PESV PostgreSQL Dev Container",
  "dockerFile": "Dockerfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-ossdata.vscode-pgsql",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/postgresql-client:1": {}
  },
  "forwardPorts": [5432, 8081],
  "postCreateCommand": "echo 'Dev Container ready. Use psql to connect to PostgreSQL via Docker Compose.'"
}